# The end-to-end suite. One call per Julia version in the matrix, plus the pairs.
#
# The matrix is declared in ../MODULE.bazel, which is where the repositories come from;
# these calls only have to agree with it. See tests/defs.bzl for what each call
# declares and the top-level README for how to add a version.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "julia_version_tests", "version_mismatch_test")

package(default_testonly = True)

# Sourced by the image tests in //image as well.
exports_files(["common.sh"])

# 1.10, the long-term support release, with the reduced set: no sysimage build (the module
# ships no PackageCompiler environment for 1.10) and no hook test (version-independent).
julia_version_tests(
    depot_repo = "@depot_1_10",
    julia_repo = "@julia_1_10",
    minor = "1.10",
    other_minor = "1.12",
    patch = "1.10.12",
    project = "//projects/v1.10",
)

julia_version_tests(
    depot_repo = "@depot_1_12",
    hook_depot_repo = "@hook_depot_1_12",
    julia_repo = "@julia_1_12",
    minor = "1.12",
    other_minor = "1.13",
    patch = "1.12.7",
    project = "//projects/v1.12",
    sysimage_depot_repo = "@sysimage_depot_1_12",
)

julia_version_tests(
    depot_repo = "@depot_1_13",
    hook_depot_repo = "@hook_depot_1_13",
    julia_repo = "@julia_1_13",
    minor = "1.13",
    other_minor = "1.12",
    patch = "1.13.0",
    project = "//projects/v1.13",
    sysimage_depot_repo = "@sysimage_depot_1_13",
)

# A 1.13 manifest under 1.12, and a 1.12 manifest under 1.13. Both directions, because
# the check compares strings and a one-sided test would pass on a check that only
# noticed one kind of difference.
version_mismatch_test(
    depot_repo = "@depot_1_12",
    julia_repo = "@julia_1_12",
    manifest_minor = "1.13",
    manifest_patch = "1.13.0",
    project = "//projects/v1.13",
    running_minor = "1.12",
    running_patch = "1.12.7",
)

version_mismatch_test(
    depot_repo = "@depot_1_13",
    julia_repo = "@julia_1_13",
    manifest_minor = "1.12",
    manifest_patch = "1.12.7",
    project = "//projects/v1.12",
    running_minor = "1.13",
    running_patch = "1.13.0",
)

# The pinned manifest must be the one Julia uses: a versioned Manifest-v1.12.toml beside
# Manifest.toml wins in Julia. Version-independent, so 1.12 alone covers it.
sh_test(
    name = "manifest_choice_1_12_test",
    size = "medium",
    srcs = ["manifest_choice_test.sh"],
    args = [
        "$(rootpath @julia_depot//julia:instantiate.sh)",
        "$(rootpath @julia_1_12//:bin/julia)",
        "$(rootpath //projects/v1.12:Manifest.toml)",
        "$(rootpath @depot_1_12//:stamp.txt)",
        "1.12",
    ],
    data = [
        "common.sh",
        "//projects/v1.12:Manifest.toml",
        "//projects/v1.12:Project.toml",
        "@depot_1_12//:stamp.txt",
        "@julia_1_12//:bin/julia",
        "@julia_1_12//:dist",
        "@julia_depot//julia:instantiate.sh",
    ],
    env = {"JULIA_PKG_SERVER": "https://pkg.julialang.org"},
    tags = ["julia1_12"],
)

# The `dir` attribute: a declared depot with a {HOME} placeholder, instead of the ambient
# JULIA_DEPOT_PATH. One version is enough; the attribute is version-independent.
sh_test(
    name = "declared_depot_1_12_test",
    size = "small",
    srcs = ["declared_depot_test.sh"],
    args = [
        "$(rootpath @declared_depot_1_12//:env.sh)",
        "$(rootpath @declared_depot_1_12//:stamp.txt)",
        ".julia-depot-e2e/declared",
    ],
    data = [
        "common.sh",
        "@declared_depot_1_12//:env.sh",
        "@declared_depot_1_12//:stamp.txt",
    ],
    tags = ["julia1_12"],
)

# `read_only_depots`: a declared depot with a shared depot and a missing one stacked behind it.
# Version-independent, like `dir`. image_depot.sh runs on the stamp too, since its registries
# then live only in the shared depot.
sh_test(
    name = "read_only_depots_1_12_test",
    size = "large",
    srcs = ["read_only_depots_test.sh"],
    args = [
        "$(rootpath @read_only_depots_1_12//:env.sh)",
        "$(rootpath @read_only_depots_1_12//:stamp.txt)",
        ".julia-depot-e2e/stacked",
        ".julia-depot-e2e/shared",
        ".julia-depot-e2e/absent",
        "$(rootpath @julia_depot//julia:image_depot.sh)",
        "$(rootpath @julia_1_12//:bin/julia)",
        "$(rootpath //projects/v1.12:Manifest.toml)",
    ],
    data = [
        "common.sh",
        "//projects/v1.12:Manifest.toml",
        "//projects/v1.12:Project.toml",
        "@julia_1_12//:bin/julia",
        "@julia_1_12//:dist",
        "@julia_depot//julia:image_depot.sh",
        "@read_only_depots_1_12//:env.sh",
        "@read_only_depots_1_12//:stamp.txt",
    ],
    env = {"JULIA_PKG_SERVER": "https://pkg.julialang.org"},
    tags = [
        "julia1_12",
        "requires-network",
    ],
)

# A damaged read-only depot, after the fetch: what loading the environment does and whether a
# refetch repairs it, for a removed package or artifact, a truncated library, corrupted compiled
# caches, modified package source and an added Overrides.toml. On copies of the seeded shared
# depot, so the fetch's own depots are never touched.
sh_test(
    name = "read_only_depots_damage_1_12_test",
    size = "large",
    srcs = ["read_only_depots_damage_test.sh"],
    args = [
        "$(rootpath @read_only_depots_1_12//:stamp.txt)",
        "$(rootpath @julia_depot//julia:instantiate.sh)",
        "$(rootpath @julia_1_12//:bin/julia)",
        "$(rootpath //projects/v1.12:Manifest.toml)",
    ],
    data = [
        "common.sh",
        "//projects/v1.12:Manifest.toml",
        "//projects/v1.12:Project.toml",
        "@julia_1_12//:bin/julia",
        "@julia_1_12//:dist",
        "@julia_depot//julia:instantiate.sh",
        "@read_only_depots_1_12//:stamp.txt",
    ],
    env = {"JULIA_PKG_SERVER": "https://pkg.julialang.org"},
    tags = [
        "julia1_12",
        "requires-network",
    ],
)

# sysimage.sh on a depot with no PackageCompiler in it, which is what a consumer following
# docs/src/recipes.md has: the matrix's sysimage tests all run over a depot that already holds
# it. The install step is version-independent, so 1.13 alone covers it.
sh_test(
    name = "sysimage_fresh_depot_1_13_test",
    size = "large",
    srcs = ["sysimage_fresh_depot_test.sh"],
    args = [
        "$(rootpath @julia_depot//julia:sysimage.sh)",
        "$(rootpath @julia_1_13//:bin/julia)",
        "$(rootpath //projects/v1.13:Manifest.toml)",
    ],
    data = [
        "common.sh",
        "//projects/v1.13:Manifest.toml",
        "//projects/v1.13:Project.toml",
        "@julia_1_13//:bin/julia",
        "@julia_1_13//:dist",
        "@julia_depot//julia:sysimage.sh",
        "@julia_depot//julia:sysimage_envs",
    ],
    env = {"JULIA_PKG_SERVER": "https://pkg.julialang.org"},
    tags = [
        "julia1_13",
        "requires-network",
    ],
)
