# The image example: an oci_image assembled from the module's layers with rules_oci, once per Julia
# version in the matrix, and the tests over it. See defs.bzl for what each call declares, and
# docs/src/images.md for the same recipe written out for a consumer.
#
#   bazel build //image:image_1_13
#   bazel test //image:all

load("@julia_depot//julia:image.bzl", "julia_sysimage", "julia_sysimage_layer")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":cc_test.bzl", "file_cc_test", "pinned_cc_test", "system_cc_test")
load(":defs.bzl", "julia_image_tests")

julia_image_tests(
    depot_repo = "@depot_1_12",
    julia_repo = "@julia_1_12",
    minor = "1.12",
    project = "//projects/v1.12",
)

julia_image_tests(
    depot_repo = "@depot_1_13",
    julia_repo = "@julia_1_13",
    minor = "1.13",
    project = "//projects/v1.13",
)

# --- the compiler that links a sysimage --------------------------------------------------------
# Analysis tests over sysimage_layer_1_13, which names no compiler, and two variants that are
# never built: one with a consumer's own julia.cc, one with the host's compiler. See cc_test.bzl.
julia_sysimage_layer(
    name = "sysimage_layer_cc_glibc_2_28",
    cc = "@cc_glibc_2_28",
    depot = "@depot_1_13",
    julia = "@julia_1_13",
    manifest = "//projects/v1.13:Manifest.toml",
    packages = ["Crayons"],
    project = "//projects/v1.13:Project.toml",
    tags = ["manual"],
)

julia_sysimage_layer(
    name = "sysimage_layer_system_cc",
    depot = "@depot_1_13",
    julia = "@julia_1_13",
    manifest = "//projects/v1.13:Manifest.toml",
    packages = ["Crayons"],
    project = "//projects/v1.13:Project.toml",
    system_cc = True,
    tags = ["manual"],
)

pinned_cc_test(
    name = "sysimage_default_cc_test",
    size = "small",
    repo = "julia_depot_cc",
    tags = ["julia1_13"],
    target_under_test = ":sysimage_layer_1_13",
)

pinned_cc_test(
    name = "sysimage_own_cc_test",
    size = "small",
    repo = "cc_glibc_2_28",
    tags = ["julia1_13"],
    target_under_test = ":sysimage_layer_cc_glibc_2_28",
)

system_cc_test(
    name = "sysimage_system_cc_test",
    size = "small",
    tags = ["julia1_13"],
    target_under_test = ":sysimage_layer_system_cc",
)

# --- julia_sysimage: the sysimage as a plain file -----------------------------------------------
# Its compiler is env_check_cc.sh, a plain file, which fails the link unless `data` and `env`
# reached the build with {execroot} expanded, then hands the call to the pinned compiler.
julia_sysimage(
    name = "sysimage_1_13",
    cc = "env_check_cc.sh",
    cpu_target = "generic",
    data = [
        "sysimage_data.txt",
        "@julia_depot_cc//:bin/cc",
        "@julia_depot_cc//:cc",
    ],
    depot = "@depot_1_13",
    env = {
        "E2E_CC_NEXT": "{execroot}/$(execpath @julia_depot_cc//:bin/cc)",
        "E2E_DATA": "{execroot}/$(execpath sysimage_data.txt)",
    },
    julia = "@julia_1_13",
    manifest = "//projects/v1.13:Manifest.toml",
    packages = ["Crayons"],
    project = "//projects/v1.13:Project.toml",
)

sh_test(
    name = "sysimage_file_1_13_test",
    size = "small",
    srcs = ["sysimage_file_test.sh"],
    args = [
        "$(rootpath :sysimage_1_13)",
        "$(rootpath @julia_1_13//:bin/julia)",
        "$(rootpath //projects/v1.13:Manifest.toml)",
        "$(rootpath @depot_1_13//:stamp.txt)",
    ],
    data = [
        ":sysimage_1_13",
        "//projects/v1.13:Manifest.toml",
        "//projects/v1.13:Project.toml",
        "//tests:common.sh",
        "@depot_1_13//:stamp.txt",
        "@julia_1_13//:bin/julia",
        "@julia_1_13//:dist",
    ],
    tags = ["julia1_13"],
)

file_cc_test(
    name = "sysimage_file_cc_test",
    size = "small",
    cc_file = "image/env_check_cc.sh",
    env_key = "E2E_DATA",
    env_path = "image/sysimage_data.txt",
    tags = ["julia1_13"],
    target_under_test = ":sysimage_1_13",
)
