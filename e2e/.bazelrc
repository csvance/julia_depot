# Always the public package server. Without this pin, a developer whose shell points
# JULIA_PKG_SERVER at a private mirror would resolve the committed manifests, which are
# public, through that mirror. With it, the tests fetch the same bytes on a workstation as
# on a CI runner with no private network.
common --repo_env=JULIA_PKG_SERVER=https://pkg.julialang.org

# The same pin for build actions: the depot layers in image/ instantiate their manifests in an
# action, through image_depot.sh.
common --action_env=JULIA_PKG_SERVER=https://pkg.julialang.org

# Read by the hook fixture. It is named in that depot's `hook_environ`, so changing it
# refetches the repository and reruns the hook. tests/hook_test.sh asserts this value, so
# the two must agree.
common --repo_env=E2E_HOOK_VALUE=julia-depot-e2e-hook

test --test_output=errors
test --test_verbose_timeout_warnings
