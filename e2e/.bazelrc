# THE PUBLIC PACKAGE SERVER, ALWAYS. A developer whose shell points JULIA_PKG_SERVER at
# a private mirror would otherwise resolve the committed manifests through it, and these
# manifests are public. Pinning it here means the tests fetch the same bytes on a
# workstation as they do on a CI runner with no private network at all.
common --repo_env=JULIA_PKG_SERVER=https://pkg.julialang.org

# The same pin for build actions, which inherit nothing either: the depot layers in image/
# instantiate their manifests in an action, through image_depot.sh.
common --action_env=JULIA_PKG_SERVER=https://pkg.julialang.org

# Read by the hook fixture, named in that depot's `hook_environ`, so changing it
# refetches the repository and reruns the hook. tests/hook_test.sh asserts this value
# came through, so the two have to agree.
common --repo_env=E2E_HOOK_VALUE=rules-julia-depot-e2e-hook

test --test_output=errors
test --test_verbose_timeout_warnings
