# The end-to-end suite. One call per Julia version in the matrix, plus the pairs.
#
# The matrix is declared in ../MODULE.bazel, which is where the repositories come from;
# these calls only have to agree with it. See tests/defs.bzl for what each call
# declares and the top-level README for how to add a version.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "julia_version_tests", "version_mismatch_test")

package(default_testonly = True)

# Sourced by the image tests in //image as well.
exports_files(["common.sh"])

julia_version_tests(
    depot_repo = "@depot_1_12",
    hook_depot_repo = "@hook_depot_1_12",
    julia_repo = "@julia_1_12",
    minor = "1.12",
    other_minor = "1.13",
    patch = "1.12.7",
    project = "//projects/v1.12",
    sysimage_depot_repo = "@sysimage_depot_1_12",
)

julia_version_tests(
    depot_repo = "@depot_1_13",
    hook_depot_repo = "@hook_depot_1_13",
    julia_repo = "@julia_1_13",
    minor = "1.13",
    other_minor = "1.12",
    patch = "1.13.0",
    project = "//projects/v1.13",
    sysimage_depot_repo = "@sysimage_depot_1_13",
)

# A 1.13 manifest under 1.12, and a 1.12 manifest under 1.13. Both directions, because
# the check compares strings and a one-sided test would pass on a check that only
# noticed one kind of difference.
version_mismatch_test(
    depot_repo = "@depot_1_12",
    julia_repo = "@julia_1_12",
    manifest_minor = "1.13",
    manifest_patch = "1.13.0",
    project = "//projects/v1.13",
    running_minor = "1.12",
    running_patch = "1.12.7",
)

version_mismatch_test(
    depot_repo = "@depot_1_13",
    julia_repo = "@julia_1_13",
    manifest_minor = "1.12",
    manifest_patch = "1.12.7",
    project = "//projects/v1.12",
    running_minor = "1.13",
    running_patch = "1.13.0",
)

# The `depot` attribute: a declared depot with a {HOME} placeholder, instead of the ambient
# JULIA_DEPOT_PATH. One version is enough; the attribute is version-independent.
sh_test(
    name = "declared_depot_1_12_test",
    size = "small",
    srcs = ["declared_depot_test.sh"],
    args = [
        "$(rootpath @declared_depot_1_12//:env.sh)",
        "$(rootpath @declared_depot_1_12//:stamp.txt)",
        ".rules-julia-depot-e2e/declared",
    ],
    data = [
        "common.sh",
        "@declared_depot_1_12//:env.sh",
        "@declared_depot_1_12//:stamp.txt",
    ],
    tags = ["julia1_12"],
)

# sysimage.sh on a depot with no PackageCompiler in it, which is what a consumer following
# docs/recipes.md has: the matrix's sysimage tests all run over a depot that already holds
# it. The install step is version-independent, so 1.13 alone covers it.
sh_test(
    name = "sysimage_fresh_depot_1_13_test",
    size = "large",
    srcs = ["sysimage_fresh_depot_test.sh"],
    args = [
        "$(rootpath @rules_julia_depot//julia:sysimage.sh)",
        "$(rootpath @julia_1_13//:bin/julia)",
        "$(rootpath //projects/v1.13:Manifest.toml)",
    ],
    data = [
        "common.sh",
        "//projects/v1.13:Manifest.toml",
        "//projects/v1.13:Project.toml",
        "@julia_1_13//:bin/julia",
        "@julia_1_13//:dist",
        "@rules_julia_depot//julia:sysimage.sh",
        "@rules_julia_depot//julia:sysimage_envs",
    ],
    env = {"JULIA_PKG_SERVER": "https://pkg.julialang.org"},
    tags = [
        "julia1_13",
        "requires-network",
    ],
)
