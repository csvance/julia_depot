"""End-to-end tests for julia_depot, over a matrix of Julia versions.

This is a separate Bazel module because the thing under test is the consumer interface: a
root module that declares `bazel_dep`, calls the extension, and uses the repositories it
produces. A test inside the module would exercise the implementation and miss the interface
consumers use.

The matrix is declared here and nowhere else. Every Julia version in it gets four
repositories, and tests/BUILD.bazel turns those into the same set of test cases for
each. Adding a version means adding one block below, one `projects/v<minor>` directory
with a Manifest resolved under that exact Julia, one `julia/sysimage/v<minor>`
environment in the module itself, one `julia_version_tests()` call in tests/BUILD.bazel,
and one `julia_image_tests()` call in image/BUILD.bazel. See docs/src/julia-versions.md.
"""

module(
    name = "julia_depot_e2e",
    version = "0.0.0",
)

bazel_dep(name = "julia_depot", version = "0.2.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# For the analysis tests in image/cc_test.bzl. Already in the graph through rules_oci.
bazel_dep(name = "bazel_skylib", version = "1.8.2")

local_path_override(
    module_name = "julia_depot",
    path = "..",
)

# rules_oci, for image/: the image example assembles an oci_image from the module's layers, the way
# a consumer would. An e2e dependency only. The module itself writes plain tars and an environment
# file, and never depends on rules_oci, so a consumer chooses its own version or none.
bazel_dep(name = "rules_oci", version = "2.2.6")

# rules_oci 2.2.6 pins aspect_bazel_lib 2.7.2, which registers its tar and zstd toolchains against
# @local_config_platform. Bazel 9 removed that repository, so toolchain resolution fails for every
# target, including ones unrelated to images. MVS takes the higher version, so declaring it here
# fixes this.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# The base of the example image: debian:bookworm-slim, pinned by digest. It is small and has the
# glibc the official Julia build needs. Any comparable base would work.
oci.pull(
    name = "debian_base",
    digest = "sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251",
    image = "index.docker.io/library/debian",
    platforms = ["linux/amd64"],
)
use_repo(oci, "debian_base", "debian_base_linux_amd64")

julia = use_extension("@julia_depot//julia:extensions.bzl", "julia")

# --- Julia 1.10, the long-term support release ------------------------------------
# A reduced set: the distribution and a depot. No sysimage depot, because the module ships no
# PackageCompiler environment for 1.10, and no hook depot, because the hook is
# version-independent.
julia.dist(
    name = "julia_1_10",
    version = "1.10.12",
)

# The environment under test, pinned to a Manifest resolved under 1.10.12.
julia.depot(
    name = "depot_1_10",
    dir = "{HOME}/.julia-depot-e2e/v1.10",
    julia = "@julia_1_10",
    manifest = "//projects/v1.10:Manifest.toml",
)

# --- Julia 1.12 -------------------------------------------------------------------
julia.dist(
    name = "julia_1_12",
    version = "1.12.7",
)

# The environment under test, pinned to a Manifest resolved under 1.12.7.
julia.depot(
    name = "depot_1_12",
    dir = "{HOME}/.julia-depot-e2e/v1.12",
    julia = "@julia_1_12",
    manifest = "//projects/v1.12:Manifest.toml",
)

# The module's own PackageCompiler environment for this minor, instantiated ahead of the
# sysimage tests so they start warm. A consumer needs no such depot: `sysimage.sh` installs
# the environment when it is missing, and tests/sysimage_fresh_depot_test.sh checks this on a
# depot that never had it.
julia.depot(
    name = "sysimage_depot_1_12",
    dir = "{HOME}/.julia-depot-e2e/v1.12",
    julia = "@julia_1_12",
    manifest = "@julia_depot//julia:sysimage/v1.12/Manifest.toml",
)

# The same project again, fetched through a `hook`. The hook records that it ran and what
# it was told to read. tests/hook_test.sh checks both, and that the hook ran before
# instantiate.
julia.depot(
    name = "hook_depot_1_12",
    dir = "{HOME}/.julia-depot-e2e/v1.12",
    hook = "//hooks:marker_hook.sh",
    hook_environ = ["E2E_HOOK_VALUE"],
    julia = "@julia_1_12",
    manifest = "//projects/v1.12:Manifest.toml",
)

# The same project once more, into a directory of its own apart from the version's: the `dir`
# attribute with a {HOME} placeholder. tests/declared_depot_test.sh checks that env.sh
# exports the expanded path with the trailing separator and that the fetch wrote there.
julia.depot(
    name = "declared_depot_1_12",
    dir = "{HOME}/.julia-depot-e2e/declared",
    julia = "@julia_1_12",
    manifest = "//projects/v1.12:Manifest.toml",
)

# The same project into a declared depot with read-only depots behind it: a shared depot,
# seeded by the hook before instantiate to stand in for a host-wide one, and a depot that never
# exists. tests/read_only_depots_test.sh checks four things. env.sh exports the stack in order
# with the trailing separator. The missing depot neither failed the fetch nor was created.
# Nothing the shared depot held was installed into `dir` again. The shared depot was not
# written to.
julia.depot(
    name = "read_only_depots_1_12",
    dir = "{HOME}/.julia-depot-e2e/stacked",
    hook = "//hooks:seed_shared_depot.sh",
    julia = "@julia_1_12",
    manifest = "//projects/v1.12:Manifest.toml",
    read_only_depots = [
        "{HOME}/.julia-depot-e2e/shared",
        "{HOME}/.julia-depot-e2e/absent",
    ],
)

# --- Julia 1.13 -------------------------------------------------------------------
julia.dist(
    name = "julia_1_13",
    version = "1.13.0",
)

# The environment under test. See the 1.12 block above for what each of these three is
# for. To add a version to the matrix, copy this block and change the numbers.
julia.depot(
    name = "depot_1_13",
    dir = "{HOME}/.julia-depot-e2e/v1.13",
    julia = "@julia_1_13",
    manifest = "//projects/v1.13:Manifest.toml",
)

# The module's own PackageCompiler environment for this minor.
julia.depot(
    name = "sysimage_depot_1_13",
    dir = "{HOME}/.julia-depot-e2e/v1.13",
    julia = "@julia_1_13",
    manifest = "@julia_depot//julia:sysimage/v1.13/Manifest.toml",
)

# The same project again, fetched through a hook.
julia.depot(
    name = "hook_depot_1_13",
    dir = "{HOME}/.julia-depot-e2e/v1.13",
    hook = "//hooks:marker_hook.sh",
    hook_environ = ["E2E_HOOK_VALUE"],
    julia = "@julia_1_13",
    manifest = "//projects/v1.13:Manifest.toml",
)

# --- a lock kept apart from its project -------------------------------------------
# projects/workspace: a workspace with one member, whose lock is deploy/Manifest.toml rather than
# a Manifest beside the Project.toml. `project` names the Project.toml, `project_srcs` the member,
# and the depot is instantiated from a copy staged in the repository. That copy has no sources,
# and the member is a path package, so `precompile = False`. `env` reaches the fetch: the hook
# fails it otherwise. image/ builds an image from this depot.
julia.depot(
    name = "workspace_depot_1_13",
    dir = "{HOME}/.julia-depot-e2e/v1.13",
    env = {"E2E_DEPOT_ENV": "julia-depot-e2e-env"},
    hook = "//hooks:env_hook.sh",
    julia = "@julia_1_13",
    manifest = "//projects/workspace:deploy/Manifest.toml",
    precompile = False,
    project = "//projects/workspace:Project.toml",
    project_srcs = ["//projects/workspace:packages/WsMember/Project.toml"],
)

# --- the ambient depot ------------------------------------------------------------
# Every other depot above declares a `dir` of the suite's own, one per Julia version, so no test
# reads or writes a depot it does not own, whatever the developer's JULIA_DEPOT_PATH holds. This
# one declares none, to test that case: it instantiates into the ambient depot, which .bazelrc
# pins to "set by nothing", so Julia's default. tests/depot_stamp_test.sh checks it.
julia.depot(
    name = "ambient_depot_1_13",
    julia = "@julia_1_13",
    manifest = "//projects/v1.13:Manifest.toml",
)

# --- C compilers for sysimages -----------------------------------------------------
# The module's own pinned compiler, @julia_depot_cc, is declared by julia_depot and imported here
# as any consumer would import it, for the sysimage.sh tests. A second compiler for another glibc
# is a consumer's own `julia.cc`; image/ uses it to show that the compiler is part of the key.
julia.cc(
    name = "cc_glibc_2_28",
    glibc = "2.28",
)

# Every repository the matrix declares, visible to //tests.
use_repo(
    julia,
    "ambient_depot_1_13",
    "cc_glibc_2_28",
    "declared_depot_1_12",
    "depot_1_10",
    "depot_1_12",
    "depot_1_13",
    "hook_depot_1_12",
    "hook_depot_1_13",
    "julia_1_10",
    "julia_1_12",
    "julia_1_13",
    "julia_depot_cc",
    "read_only_depots_1_12",
    "sysimage_depot_1_12",
    "sysimage_depot_1_13",
    "workspace_depot_1_13",
)
