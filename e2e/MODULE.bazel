"""End-to-end tests for rules_julia_depot, over a matrix of Julia versions.

This is a separate Bazel module rather than a package of the module under test, because
what is being tested IS the consumer interface: a root module that declares
`bazel_dep`, calls the extension, and uses the repositories it produces. A test inside
the module would exercise the implementation and miss the seam that consumers land on.

THE MATRIX lives here and nowhere else. Every Julia version in it gets four
repositories, and tests/BUILD.bazel turns those into the same set of test cases for
each. Adding a version means adding one block below, one `projects/v<minor>` directory
with a Manifest resolved under that exact Julia, one `julia/sysimage/v<minor>`
environment in the module itself, one `julia_version_tests()` call in tests/BUILD.bazel,
and one `julia_image_tests()` call in image/BUILD.bazel. See docs/src/julia-versions.md.
"""

module(
    name = "rules_julia_depot_e2e",
    version = "0.0.0",
)

bazel_dep(name = "rules_julia_depot", version = "0.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

local_path_override(
    module_name = "rules_julia_depot",
    path = "..",
)

# rules_oci, for image/: the image example assembles an oci_image from the module's layers, the way
# a consumer would. An e2e dependency only. The module itself writes plain tars and an environment
# file, and never depends on rules_oci, so a consumer chooses its own version or none.
bazel_dep(name = "rules_oci", version = "2.2.6")

# rules_oci 2.2.6 pins aspect_bazel_lib 2.7.2, which registers its tar and zstd toolchains against
# @local_config_platform. Bazel 9 removed that repository, so toolchain resolution fails for every
# target, including ones that have nothing to do with images. MVS takes the higher version, so
# naming it here is the whole fix.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# The base the example image starts from: debian:bookworm-slim, pinned by digest. Small, and with
# the glibc the official Julia build needs; anything comparable would do.
oci.pull(
    name = "debian_base",
    digest = "sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251",
    image = "index.docker.io/library/debian",
    platforms = ["linux/amd64"],
)
use_repo(oci, "debian_base", "debian_base_linux_amd64")

julia = use_extension("@rules_julia_depot//julia:extensions.bzl", "julia")

# --- Julia 1.12 -------------------------------------------------------------------
julia.toolchain(
    name = "julia_1_12",
    version = "1.12.7",
)

# The environment under test, pinned to a Manifest resolved under 1.12.7.
julia.depot(
    name = "depot_1_12",
    julia = "@julia_1_12//:bin/julia",
    manifest = "//projects/v1.12:Manifest.toml",
)

# The module's own PackageCompiler environment for this minor, instantiated ahead of the
# sysimage tests so they start warm. A consumer needs no such depot: `sysimage.sh`
# installs the environment itself when it is missing, which
# tests/sysimage_fresh_depot_test.sh checks on a depot that never had it.
julia.depot(
    name = "sysimage_depot_1_12",
    julia = "@julia_1_12//:bin/julia",
    manifest = "@rules_julia_depot//julia:sysimage/v1.12/Manifest.toml",
)

# The same project again, fetched through a `hook`. The hook records that it ran and
# what it was told to read; tests/hook_test.sh checks both, and checks that it ran
# before instantiate rather than after.
julia.depot(
    name = "hook_depot_1_12",
    hook = "//hooks:marker_hook.sh",
    hook_environ = ["E2E_HOOK_VALUE"],
    julia = "@julia_1_12//:bin/julia",
    manifest = "//projects/v1.12:Manifest.toml",
)

# The same project once more, into a DECLARED depot rather than the ambient one: the
# `depot` attribute with a {HOME} placeholder. tests/declared_depot_test.sh checks that
# env.sh exports the expanded path with the trailing separator and that the fetch landed
# there.
julia.depot(
    name = "declared_depot_1_12",
    depot = "{HOME}/.rules-julia-depot-e2e/declared",
    julia = "@julia_1_12//:bin/julia",
    manifest = "//projects/v1.12:Manifest.toml",
)

# --- Julia 1.13 -------------------------------------------------------------------
julia.toolchain(
    name = "julia_1_13",
    version = "1.13.0",
)

# The environment under test. See the 1.12 block above for what each of these three is
# for; a version added to the matrix is this block again with the numbers changed.
julia.depot(
    name = "depot_1_13",
    julia = "@julia_1_13//:bin/julia",
    manifest = "//projects/v1.13:Manifest.toml",
)

# The module's own PackageCompiler environment for this minor.
julia.depot(
    name = "sysimage_depot_1_13",
    julia = "@julia_1_13//:bin/julia",
    manifest = "@rules_julia_depot//julia:sysimage/v1.13/Manifest.toml",
)

# The same project again, fetched through a hook.
julia.depot(
    name = "hook_depot_1_13",
    hook = "//hooks:marker_hook.sh",
    hook_environ = ["E2E_HOOK_VALUE"],
    julia = "@julia_1_13//:bin/julia",
    manifest = "//projects/v1.13:Manifest.toml",
)

# Every repository the matrix declares, visible to //tests.
use_repo(
    julia,
    "declared_depot_1_12",
    "depot_1_12",
    "depot_1_13",
    "hook_depot_1_12",
    "hook_depot_1_13",
    "julia_1_12",
    "julia_1_13",
    "sysimage_depot_1_12",
    "sysimage_depot_1_13",
)
