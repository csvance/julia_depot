# julia_depot: a Julia environment pinned to a committed Manifest.toml, as Bazel
# repositories and scripts. See README.md for the contract and the consumer interface.
#
# compatibility_level records breaking changes to the consumer interface, which is small and
# explicit: a change to it breaks every consumer at once, so the module graph should be able to
# record that. Raise it when one of these changes incompatibly; added behaviour does not count:
#
#   - the `julia` extension's tag classes (dist, depot, cc) and their attributes
#   - the rules and functions in julia/image.bzl, their attributes and JuliaImageEnvInfo,
#     and the names PORTABLE_X86_64_CPU_TARGET and PORTABLE_AARCH64_CPU_TARGET (their
#     values may gain CPU clones in any release, as Julia's official builds do)
#   - what a depot repository provides: its default target, :env, env.sh (which exports
#     JULIA_DEPOT_PATH and nothing else) and stamp.txt with its keys manifest_sha256,
#     julia_version, host_triplet and depot (the whole depot path env.sh exports: the entry
#     written to, `dir`, followed by any read_only_depots)
#   - what a dist repository provides: its default target, :dist and bin/julia
#   - what a cc repository provides: its default target, :cc and bin/cc, and the module's own
#     @julia_depot_cc, the compiler julia_sysimage_layer uses by default
#   - the arguments and JULIA_DEPOT_* variables of image_depot.sh and sysimage.sh, and
#     what a hook is given
#
# Internal and free to change in any release: julia/dist.bzl, julia/depot.bzl and julia/cc.bzl
# (use the extension, which also checks repository names across the graph, and do not load their
# rules with use_repo_rule), and the scripts instantiate.sh and image_layers.sh.
#
# Built and tested with Bazel 9 only.
module(
    name = "julia_depot",
    version = "0.2.0",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 2,
)

# The CPU constraints the image rules read to pick a portable CPU target list for the target
# platform (x86_64 or aarch64).
bazel_dep(name = "platforms", version = "1.0.0")

# The compiler that links sysimages unless a consumer names another: zig at the version and glibc
# target julia/cc.bzl defaults to. Declared here so julia_sysimage_layer can default to it, and
# visible to any module that uses the extension through use_repo(julia, "julia_depot_cc").
julia = use_extension("//julia:extensions.bzl", "julia")
julia.cc(name = "julia_depot_cc")
use_repo(julia, "julia_depot_cc")
